{
  "name": "brigade",
  "version": "0.4.0",
  "private": true,
  "description": "Brigade — mentorship for private chefs",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @connectpro/web dev",
    "dev:stop": "pkill -f 'next dev --port 3100' 2>/dev/null || true; lsof -ti:3100 | xargs kill -9 2>/dev/null || true",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "typecheck": "turbo typecheck",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:guardrails": "node scripts/check-guardrails.mjs",
    "verify": "pnpm check:guardrails && pnpm check:architecture && pnpm typecheck && pnpm lint",
    "prepare": "git config core.hooksPath .githooks || true",
    "db:migrate": "node scripts/migrate.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "generate:countries": "node scripts/generate-country-codes.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "dotenv-cli": "^8.0.0",
    "pg": "^8.13.1",
    "playwright": "^1.49.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "next": "15.5.22",
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.18"
    }
  }
}
