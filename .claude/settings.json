{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(vercel:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(psql postgresql://*supabase*)",
      "Bash(psql postgres://*supabase*)",
      "Bash(psql *pooler.supabase.com*)",
      "Bash(*pooler.supabase.com*)",
      "Bash(supabase db:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./apps/web/.env)",
      "Read(./apps/web/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./apps/web/.env)",
      "Edit(./apps/web/.env.*)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout main:*)",
      "Bash(git branch -D:*)",
      "Bash(docker compose down:*)",
      "Bash(pnpm dev:stop:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
