# Brigade — mentorship for private chefs
# Stack: Next.js (apps/web) + Postgres. Nothing else.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local Docker (`pnpm infra:up`):
# DATABASE_URL=postgresql://connectpro:connectpro@localhost:5432/connectpro
# AUTH_SCHEMA=connectpro_auth
#
# Supabase (Vercel / prod): use the Transaction pooler URI (port 6543), not
# the direct db.[PROJECT].supabase.co host (IPv6-only on many networks).
# DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# AUTH_SCHEMA=connectpro_auth
# SUPABASE_REGION=us-east-1
#
# Or discrete vars if the password contains @ or #:
# SUPABASE_DB_HOST=aws-0-us-west-2.pooler.supabase.com
# SUPABASE_DB_USER=postgres.your-project-ref
# SUPABASE_DB_PASSWORD=your-db-password
# SUPABASE_DB_PORT=6543

DATABASE_URL=postgresql://connectpro:connectpro@localhost:5432/connectpro
AUTH_SCHEMA=connectpro_auth

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=generate-a-long-random-string-here
# JWT_EXPIRES_IN=15m
# REFRESH_EXPIRES_IN=7d
# Local-only when JWT_SECRET is unset:
# ALLOW_INSECURE_JWT_FALLBACK=true

# Passwordless login codes (Resend). Without these, codes are logged in
# development only and login emails are not sent.
# RESEND_API_KEY=
# RESEND_FROM=Brigade <hello@joinbrigade.co>

# Optional debug password login (ignored in production):
# DEBUG_LOGIN_BACKDOOR=true
# DEBUG_LOGIN_EMAIL=dev@example.com
# DEBUG_LOGIN_PASSWORD=use-a-strong-password

# Shared-password demo gate at /demo (min 12 chars). In production also set
# DEMO_ACCESS_ENABLED=true or the gate stays closed.
# DEMO_PASSWORD=your-long-demo-password
# DEMO_ACCOUNT_EMAIL=demo@joinbrigade.co
# DEMO_ACCESS_ENABLED=true
# Dev-only one-click login:
# DEMO_LOGIN_EMAIL=
# DEMO_LOGIN_PASSWORD=

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Optional; most API calls are same-origin /api/*
# NEXT_PUBLIC_API_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# Stripe (mentorship payouts + Checkout)
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Platform fee in basis points (100 = 1%). Default 1000 (10%).
# STRIPE_PLATFORM_FEE_BPS=1000

# ---------------------------------------------------------------------------
# Kit / ConvertKit waitlist (optional)
# ---------------------------------------------------------------------------
# KIT_FORM_ID=9691589
# KIT_API_KEY=
# KIT_API_SECRET=
